# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# SMTP (Brevo)
# Para que los correos LLEGUEN (y no salgan de NN.brevosend.com):
# 1) Brevo → Senders, domains & dedicated IPs → Domains → Add a domain → añade los registros DNS (DKIM, etc.).
# 2) Cuando el dominio esté "Authenticated", crea un sender con email @ese-dominio (mismo dominio verificado).
# 3) EMAIL_FROM debe ser exactamente ese remitente (p. ej. Sandra Lorden <hola@tudominio.com>).
# 4) SMTP_USER en Brevo es un identificador SMTP (no tiene por qué coincidir con el dominio del From).
# Guía: https://help.brevo.com/hc/en-us/articles/8109135223066-Authenticate-your-domain-to-improve-the-deliverability-of-your-emails-DKIM-DMARC-DNS
# Si dejas un @brevosend.com en EMAIL_FROM, el servidor registrará un aviso en logs; puedes silenciarlo con EMAIL_SKIP_BREVO_SENDER_WARN=1
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_smtp_user
SMTP_PASS=your_brevo_smtp_key
EMAIL_PROVIDER=brevo_smtp
# Optional: replies go to Sandra (defaults to SANDRA_EMAIL if unset)
EMAIL_REPLY_TO=

# Stripe (payments)
STRIPE_SECRET_KEY=sk_live_or_test_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
# Public site URL (no trailing slash). MUST match the port where you run `npm run dev`
# (e.g. http://localhost:3003). If this is 3001 but Next runs on 3003, Supabase recovery
# links will redirect to the wrong host and show otp_expired / access_denied.
# Supabase → Authentication → URL Configuration: Site URL + Redirect URLs with same PORT.
# Añade rutas de retorno: .../login y .../login?nueva=1 (y /en/login si usas inglés con prefijo).
# Incluye siempre el esquema: http://localhost:3001 o https://tu-dominio.com
NEXT_PUBLIC_APP_URL=https://your-domain.com

# Dominio PROPIO verificado en Brevo (no uses @gmail.com aquí si envías por Brevo: rompe SPF/DMARC).
EMAIL_FROM=Sandra Lorden <info@your-domain.com>
SANDRA_EMAIL=sandralordenfit@gmail.com

# Cita virtual (Stripe + huecos generados en servidor; sin Calendly)
# Meet fijo (Gmail personal recomendado: misma sala para todas las citas).
VIRTUAL_APPOINTMENT_MEET_URL=https://meet.google.com/xxx-xxxx-xxx
# Opcional — Google Calendar: eventos automáticos al pagar (comparte el calendario con la cuenta de servicio, permiso de edición).
# Con Gmail personal el Meet no se genera por API: usa VIRTUAL_APPOINTMENT_MEET_URL y el enlace se pone en la descripción del evento.
# Meet distinto por cita suele requerir Google Workspace + GOOGLE_CALENDAR_DELEGATED_USER.
# GOOGLE_CALENDAR_ID=xxxx@group.calendar.google.com
# GOOGLE_SERVICE_ACCOUNT_EMAIL=xxx@proyecto.iam.gserviceaccount.com
# Solo Google Workspace (delegación de dominio en Admin). Suplanta a este usuario al crear el Meet:
# GOOGLE_CALENDAR_DELEGATED_USER=sandra@tudominio.com
# Clave del JSON de la cuenta de servicio: una sola línea entre comillas, con \n (barra+n) entre secciones PEM:
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
# Precio en euros (entero o decimal)
VIRTUAL_APPOINTMENT_PRICE_EUR=60
# Zona horaria de los huecos (Sandra)
VIRTUAL_APPOINTMENT_TZ=Europe/Madrid
# Lunes=1 … Domingo=7 (por defecto lun–vie)
VIRTUAL_APPOINTMENT_WEEKDAYS=1,2,3,4,5
# Franja horaria local (HH:MM)
VIRTUAL_APPOINTMENT_DAY_START=10:00
VIRTUAL_APPOINTMENT_DAY_END=18:00
# Duración de cada cita (minutos)
VIRTUAL_APPOINTMENT_DURATION_MINUTES=45
# Días hacia adelante con huecos
VIRTUAL_APPOINTMENT_HORIZON_DAYS=21
# Cuánto tiempo bloquea un hueco tras iniciar checkout sin pagar
VIRTUAL_APPOINTMENT_PENDING_HOLD_MINUTES=45

# Sentry (errores en producción; opcional en local)
# Crea un proyecto en https://sentry.io y pega el DSN del cliente.
NEXT_PUBLIC_SENTRY_DSN=
