# URL pública del sitio (producción: https://www.sandralorden.com)
# Usada en emails de Supabase, Stripe y enlaces de recuperación de contraseña.
NEXT_PUBLIC_APP_URL=https://www.sandralorden.com

# Cambiar contraseña de un usuario sin email (solo local, requiere service role):
# npm run admin:reset-password -- sandralordenfit@gmail.com "nueva-contraseña"

# Migración media kit (una vez; URI en Supabase → Settings → Database):
# SUPABASE_DB_URL=postgresql://postgres.[ref]:[PASSWORD]@db.[ref].supabase.co:5432/postgres
# npm run db:migrate-media-kit

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (email)
RESEND_API_KEY=re_your_api_key

# Email configuration
EMAIL_FROM=Sandra Lorden <onboarding@resend.dev>
SANDRA_EMAIL=sandralordenfit@gmail.com

# Media Kit — métricas opcionales de Instagram (texto libre, ej. "12.5K", "3,2%")
# NEXT_PUBLIC_MEDIA_KIT_IG_FIT_FOLLOWERS=
# NEXT_PUBLIC_MEDIA_KIT_IG_PERSONAL_FOLLOWERS=
# NEXT_PUBLIC_MEDIA_KIT_IG_ENGAGEMENT=
